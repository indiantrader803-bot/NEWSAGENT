# ═══════════════════════════════════════════════════════════════════════
# 24/7 Market Monitoring Bot - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# TELEGRAM CONFIGURATION (Required)
# ─────────────────────────────────────────────────────────────────────────

# Primary Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567

# Telegram Chat/Channel ID (Use @userinfobot or @myidbot)
# For channels: @your_channel_name
# For groups: -1001234567890
TELEGRAM_CHAT_ID=@your_channel_name

# Optional: Additional Telegram Bots for Redundancy
BOT_TOKEN2=
BOT_TOKEN3=

# Optional: Alternate Chat ID for Third Bot
TELEGRAM_CHAT_ID3=


# ─────────────────────────────────────────────────────────────────────────
# NEWS APIs (At least ONE required)
# ─────────────────────────────────────────────────────────────────────────

# NewsAPI.org (Free: 100 requests/day)
# Get key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# NewsData.io (Free: 200 requests/day)
# Get key: https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_key_here

# News Provider Selection: auto, newsapi, or newsdata
NEWS_PROVIDER=auto


# ─────────────────────────────────────────────────────────────────────────
# AI APIs (At least ONE required for AI features)
# ─────────────────────────────────────────────────────────────────────────

# Groq API (Free tier available, very fast)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Pay-as-you-go)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# ─────────────────────────────────────────────────────────────────────────
# MARKET DATA APIs
# ─────────────────────────────────────────────────────────────────────────

# Finnhub (Free: 60 calls/minute)
# Get key: https://finnhub.io/register
# Used for: Real-time WebSocket, breaking news, company data
FINNHUB_API_KEY=your_finnhub_key_here

# Massive API (Optional)
MASSIVE_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# SOCIAL MEDIA APIs (Optional but Recommended)
# ─────────────────────────────────────────────────────────────────────────

# Twitter/X Bearer Token (For real-time Twitter monitoring)
# Get from: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# Twitter accounts to monitor (comma-separated)
TWITTER_USERNAMES=reuters,investingcom,fxstreet,stocktwits,benzinga

# Twitter search query
TWITTER_SEARCH_QUERY=forex crypto stocks india market


# ─────────────────────────────────────────────────────────────────────────
# 24/7 WORKER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# Check intervals (seconds)
CHECK_INTERVAL_FAST=30              # During active trading hours
CHECK_INTERVAL_SLOW=120             # During off-peak hours
NEWS_CHECK_INTERVAL=180             # News fetching interval
CRYPTO_CHECK_INTERVAL=300           # Crypto screening interval
INDIAN_MARKET_INTERVAL=60           # Indian market updates
US_MARKET_INTERVAL=60               # US market updates
FOREX_SIGNAL_INTERVAL=600           # Forex signal generation
MESSAGE_COOLDOWN=120                # Seconds between similar messages


# ─────────────────────────────────────────────────────────────────────────
# LEGACY CONFIGURATION (For backward compatibility)
# ─────────────────────────────────────────────────────────────────────────

# Old bot tokens (can use BOT_TOKEN2 instead)
BOT_TOKEN2=

# Fetch interval for old news cycle
FETCH_INTERVAL_SECONDS=900

# High impact event check interval
HIGH_IMPACT_CHECK_INTERVAL=60

# Live news RSS feeds (comma-separated)
LIVE_NEWS_ENABLED=true
LIVE_NEWS_FEEDS=https://feeds.feedburner.com/forexcom,https://www.investing.com/rss/news_1.rss,https://www.forexlive.com/Feed/News,https://finance.yahoo.com/news/rss

# Crypto screening
CRYPTO_SCAN_INTERVAL=300
CRYPTO_MAX_CANDIDATES=5

# News queries for old system
FOREX_QUERY=forex OR "foreign exchange" OR (dollar AND fed) OR (euro AND ecb) OR (pound AND boe) OR (yen AND boj) OR (gold AND fed) OR (rupee AND rbi) OR (bitcoin OR btc OR ethereum OR eth OR crypto) OR (crude oil OR brent OR wti) OR (nasdaq OR "dow jones" OR "s&p 500")

INDIA_MARKET_QUERY=(sensex OR nifty OR "indian market" OR "india stock" OR "bse" OR "nse" OR "rbi" OR "rupee" OR "sebi" OR "indian economy") AND (india OR mumbai)

INTRADAY_STOCK_QUERY=(reliance OR tcs OR hdfc OR infosys OR icici OR "hindustan unilever" OR sbi OR bharti OR "intraday" OR "stock market today" OR "opening bell" OR "closing bell" OR zomato OR adani) AND (india OR "bse" OR "nse" OR "bombay stock exchange")


# ─────────────────────────────────────────────────────────────────────────
# ADVANCED CONFIGURATION (Optional)
# ─────────────────────────────────────────────────────────────────────────

# AI model selection (for future use)
AI_MODEL=gpt-4o-mini

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Time zone (UTC recommended for consistency)
TZ=UTC

# Maximum articles per news cycle (old system)
MAX_ARTICLES_PER_CYCLE=5


# ─────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────
#
# Required for Basic Operation:
# - BOT_TOKEN
# - TELEGRAM_CHAT_ID
# - At least one NEWS API key
# - At least one AI API key
#
# Recommended for Full Features:
# - FINNHUB_API_KEY (for real-time alerts)
# - GROQ_API_KEY (fast and free AI)
# - OPENAI_API_KEY (higher quality AI, paid)
#
# Optional Enhancements:
# - BOT_TOKEN2, BOT_TOKEN3 (redundancy)
# - TWITTER_BEARER_TOKEN (social sentiment)
# - MASSIVE_API_KEY (additional data)
#
# Performance Tuning:
# - Increase intervals to reduce message frequency
# - Decrease intervals for more real-time alerts
# - Adjust MESSAGE_COOLDOWN to control spam
#
# ═══════════════════════════════════════════════════════════════════════
