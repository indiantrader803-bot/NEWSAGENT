# Systemd service file for 24/7 Market Monitoring Bot
# Installation: sudo cp market-bot-24x7.service /etc/systemd/system/
# Enable: sudo systemctl enable market-bot-24x7
# Start: sudo systemctl start market-bot-24x7
# Status: sudo systemctl status market-bot-24x7
# Logs: sudo journalctl -u market-bot-24x7 -f

[Unit]
Description=24/7 Market Monitoring Telegram Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=your_username
Group=your_group
WorkingDirectory=/path/to/Forexsignal
EnvironmentFile=/path/to/Forexsignal/.env

# Main command
ExecStart=/usr/bin/python3 /path/to/Forexsignal/unified_24x7_worker.py

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Resource limits
MemoryLimit=512M
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=market-bot-24x7

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/path/to/Forexsignal

[Install]
WantedBy=multi-user.target
